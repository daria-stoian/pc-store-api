# Copiază în .env și completează
PORT=3000

# PostgreSQL (parola setată la instalare, utilizatorul implicit este "postgres")
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=parola_ta
DB_NAME=pc_store

# Folosește un șir lung și aleator (minim 16 caractere)
JWT_SECRET=schimba-ma-cu-un-secret-lung
JWT_EXPIRES_IN=1h

# Conturile create de scriptul de seed (db:seed)
ADMIN_EMAIL=admin@pcstore.ro
ADMIN_PASSWORD=Admin123!
